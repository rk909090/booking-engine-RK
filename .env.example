# Copy to .env.local (never commit real values).
# Values come from Supabase: Project booking-engine-rk -> Connect.

# Pooled connection used by the running app (transaction pooler, port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres"

# Direct/session connection used for migrations and seeding (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres"

DATABASE_URL="postgresql://postgres.vmomyytmjyhywvcbwgfr:PASSWORD_DB_ANDA@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Session pooler used for migrations and seeding (port 5432).
DIRECT_URL="postgresql://postgres.vmomyytmjyhywvcbwgfr:PASSWORD_DB_ANDA@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

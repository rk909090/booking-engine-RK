# Copy to .env.local (never commit real values) and replace PASSWORD_DB_ANDA.
# Values come from Supabase: project booking-engine-rk -> Connect.
# The direct connection (db.<ref>.supabase.co) is IPv6-only, so both use the pooler.

# Connection used by the running app: the SESSION pooler (port 5432).
# Do not use the transaction pooler (6543): with postgres-js under Next.js it
# left some queries hanging forever (tested 25 Nov 2026).
DATABASE_URL="postgresql://postgres.vmomyytmjyhywvcbwgfr:PASSWORD_DB_ANDA@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Session pooler used for migrations and seeding (port 5432).
DIRECT_URL="postgresql://postgres.vmomyytmjyhywvcbwgfr:PASSWORD_DB_ANDA@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Public origin of the app (no trailing slash). Locally: http://localhost:3000
BETTER_AUTH_URL="https://be.attarahospitality.com"

# Random secret, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="<generate-a-random-secret>"
